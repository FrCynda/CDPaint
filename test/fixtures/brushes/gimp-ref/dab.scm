(let* ((img (car (gimp-image-new 200 200 RGB)))
       (lay (car (gimp-layer-new img 200 200 RGBA-IMAGE "ink" 100 LAYER-MODE-NORMAL))))
  (gimp-image-insert-layer img lay 0 0)
  (gimp-brushes-refresh)
  (gimp-context-set-brush "a soft round one")
  (gimp-context-set-dynamics "Dynamics Off")
  (gimp-context-set-brush-default-size)
  (gimp-context-set-brush-default-hardness)
  (gimp-context-set-brush-aspect-ratio 0)
  (gimp-context-set-brush-angle 0)
  (gimp-context-set-opacity 100)
  (gimp-context-set-paint-mode LAYER-MODE-NORMAL)
  (gimp-context-set-foreground '(0 0 0))
  (gimp-paintbrush lay 0 2 #(100.0 100.0) PAINT-CONSTANT 0)
  (gimp-file-save RUN-NONINTERACTIVE img lay "C:/Users/frenc/AppData/Local/Temp/claude/C--Users-frenc-Desktop-CDPaint/debda006-90b3-4719-8453-f9af2fb6c972/scratchpad/gimp-dab.png" "gimp-dab.png")
